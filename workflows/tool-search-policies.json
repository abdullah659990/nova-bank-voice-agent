    {
      "parameters": {
        "jsCode": "// Cards further away than this are treated as \"not relevant\"\nconst MAX_DISTANCE = 0.40;\n\nconst items = $input.all().map(item => item.json);\n\nconst cards = items\n  .map(j => ({\n    text: j.document?.pageContent ?? j.pageContent ?? '',\n    source: j.document?.metadata?.source ?? j.metadata?.source ?? 'Nova Bank policy',\n    score: typeof j.score === 'number' ? j.score : 0,\n  }))\n  .filter(c => c.text.trim().length > 0)\n  .filter(c => c.score <= MAX_DISTANCE);\n\nif (cards.length === 0) {\n  return [{ json: { result: 'NO POLICY FOUND. Nova Bank has no policy information about this. Tell the caller you do not have that information and that a specialist can help.' } }];\n}\n\nconst combined = cards\n  .map((c, n) => `Excerpt ${n + 1} (${c.source}):\\n${c.text}`)\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    result:\n      'NOVA BANK POLICY EXCERPTS. Answer only using the information below. ' +\n      'If it does not answer the caller\\'s question, say you do not have that information and that a specialist can help. ' +\n      'Summarize in one or two spoken sentences.\\n\\n' + combined,\n  },\n}];"
      },
