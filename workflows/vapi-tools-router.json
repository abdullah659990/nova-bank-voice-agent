    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Read Vapi's tool request and keep only what we need\nconst message = $json.body?.message || {};\nconst call = message.toolCallList?.[0] || {};\nconst fn = call.function || {};\n\n// The AI's filled-in blanks. Vapi may send them as text or as an object.\nlet args = fn['arguments'] ?? {};\nif (typeof args === 'string') {\n  try {\n    args = JSON.parse(args);\n  } catch (e) {\n    args = {};\n  }\n}\n\nreturn {\n  json: {\n    tool_name: fn.name || '',\n    tool_call_id: call.id || '',\n    args: args,\n    caller_number: message.call?.customer?.number || '',\n    call_id: message.call?.id || '',\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
